#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
suffix="${GITHUB_RUN_ID:-$$}-${GITHUB_RUN_ATTEMPT:-0}"
image="rails-app-production-smoke:${suffix}"
network="rails-app-smoke-${suffix}"
database="rails-app-smoke-db-${suffix}"
app="rails-app-smoke-web-${suffix}"
worker="rails-app-smoke-worker-${suffix}"
database_gate="rails-app-smoke-database-gate-${suffix}"
postgres_image="${POSTGRES_IMAGE:-postgres:18}"
token="${suffix}"

cleanup() {
  status=$?
  trap - EXIT INT TERM
  if (( status != 0 )) && docker inspect "${app}" >/dev/null 2>&1; then
    echo "Production container logs:" >&2
    docker logs "${app}" >&2 || true
  fi
  if (( status != 0 )) && docker inspect "${worker}" >/dev/null 2>&1; then
    echo "Production worker logs:" >&2
    docker logs "${worker}" >&2 || true
  fi
  if (( status != 0 )) && docker inspect "${database_gate}" >/dev/null 2>&1; then
    echo "Database preparation gate logs:" >&2
    docker logs "${database_gate}" >&2 || true
  fi
  if (( status != 0 )) && docker inspect "${database}" >/dev/null 2>&1; then
    echo "PostgreSQL container logs:" >&2
    docker logs "${database}" >&2 || true
  fi
  docker rm --force "${app}" "${worker}" "${database_gate}" "${database}" >/dev/null 2>&1 || true
  docker network rm "${network}" >/dev/null 2>&1 || true
  docker image rm "${image}" >/dev/null 2>&1 || true
  exit "${status}"
}
trap cleanup EXIT INT TERM

wait_for_health() {
  container=$1
  attempts=$2
  for ((attempt = 1; attempt <= attempts; attempt++)); do
    health="$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${container}")"
    [[ "${health}" == "healthy" ]] && return 0
    [[ "${health}" == "exited" || "${health}" == "dead" || "${health}" == "unhealthy" ]] && return 1
    sleep 1
  done
  return 1
}

assert_http_status() {
  expected=$1
  url=$2
  shift 2
  actual="$(curl --silent --output /dev/null --write-out '%{http_code}' "$@" "${url}")"
  [[ "${actual}" == "${expected}" ]] || {
    echo "Expected HTTP ${expected} from ${url}, got ${actual}" >&2
    return 1
  }
}

assert_enforced_csp() {
  url=$1
  shift
  headers="$(curl --silent --show-error --dump-header - --output /dev/null "$@" "${url}")"

  grep --ignore-case --quiet '^content-security-policy:' <<<"${headers}" || {
    echo "Expected an enforced Content-Security-Policy header from ${url}" >&2
    return 1
  }
  if grep --ignore-case --quiet '^content-security-policy-report-only:' <<<"${headers}"; then
    echo "Expected no report-only Content-Security-Policy header from ${url}" >&2
    return 1
  fi
}

cd "${root}"
bin/package-manager-check
docker build --tag "${image}" .

runtime_user="$(docker run --rm --entrypoint id "${image}" -u)"
[[ "${runtime_user}" == "1000" ]] || { echo "Expected runtime UID 1000, got ${runtime_user}" >&2; exit 1; }
for excluded_gem in brakeman foreman image_processing ruby-vips selenium-webdriver standard; do
  if docker run --rm --entrypoint bundle "${image}" show "${excluded_gem}" >/dev/null 2>&1; then
    echo "Production image unexpectedly contains ${excluded_gem}" >&2
    exit 1
  fi
done
if docker run --rm --entrypoint dpkg-query "${image}" --show "libvips*" >/dev/null 2>&1; then
  echo "Production image unexpectedly contains libvips" >&2
  exit 1
fi
if docker run --rm --entrypoint sh "${image}" -c 'find /rails/public/assets -type f -name "application-*.js.map" -print -quit | grep -q .' ; then
  echo "Production image unexpectedly publishes its application source map" >&2
  exit 1
fi

docker network create "${network}" >/dev/null
docker run --detach --name "${database}" --network "${network}" \
  --env POSTGRES_USER=postgres \
  --env POSTGRES_PASSWORD=postgres \
  --env POSTGRES_DB=app_production \
  --health-cmd='pg_isready -U postgres -d app_production' \
  --health-interval=1s --health-timeout=3s --health-retries=30 \
  "${postgres_image}" >/dev/null
wait_for_health "${database}" 45 || { docker logs "${database}" >&2; exit 1; }

database_url="postgres://postgres:postgres@${database}:5432/app_production"
cache_database_url="postgres://postgres:postgres@${database}:5432/app_production_cache"
queue_database_url="postgres://postgres:postgres@${database}:5432/app_production_queue"
cable_database_url="postgres://postgres:postgres@${database}:5432/app_production_cable"

for logical_database in app_production_cache app_production_queue app_production_cable; do
  docker exec "${database}" createdb --username postgres "${logical_database}"
done

common_runtime_environment=(
  --env DATABASE_URL="${database_url}"
  --env CACHE_DATABASE_URL="${cache_database_url}"
  --env QUEUE_DATABASE_URL="${queue_database_url}"
  --env CABLE_DATABASE_URL="${cable_database_url}"
  --env SECRET_KEY_BASE="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
  --env DB_POOL=3
  --env CACHE_DB_POOL=3
  --env RAILS_MAX_THREADS=3
  --env AI_JOB_THREADS=5
  --env DEFAULT_JOB_THREADS=2
  --env OBJECT_STORAGE_ACCESS_KEY_ID=production-smoke-access-key
  --env OBJECT_STORAGE_SECRET_ACCESS_KEY=production-smoke-secret-key
  --env OBJECT_STORAGE_REGION=us-east-1
  --env OBJECT_STORAGE_BUCKET=case-chat-production-smoke
  --env RENDER_EXTERNAL_HOSTNAME=render.test
  --env SMOKE_TOKEN="${token}"
  --env 'RUBYOPT=-rbundler/setup -r/rails/script/production_smoke_job'
)

web_runtime_environment=(
  "${common_runtime_environment[@]}"
  --env CABLE_DB_POOL=3
  --env QUEUE_DB_POOL=2
)

worker_runtime_environment=(
  "${common_runtime_environment[@]}"
  --env CABLE_DB_POOL=5
  --env QUEUE_DB_POOL=7
)

docker run --detach --name "${database_gate}" --network "${network}" \
  "${worker_runtime_environment[@]}" \
  --env DATABASE_PREPARE_WAIT_SECONDS=120 \
  "${image}" ./bin/wait-for-database-preparation >/dev/null

sleep 2
[[ "$(docker inspect --format '{{.State.Status}}' "${database_gate}")" == "running" ]] || {
  echo "Database preparation gate exited before the web migration phase" >&2
  exit 1
}

docker run --rm --network "${network}" \
  "${web_runtime_environment[@]}" \
  "${image}" ./bin/rails db:migrate:primary

# Let the gate observe the post-primary state at least twice. Otherwise a gate
# that incorrectly ignores unprepared secondary schemas could still be asleep
# during the assertion and exit immediately afterward.
sleep 5
[[ "$(docker inspect --format '{{.State.Status}}' "${database_gate}")" == "running" ]] || {
  echo "Database preparation gate ignored unprepared Solid databases" >&2
  exit 1
}

docker run --rm --network "${network}" \
  "${web_runtime_environment[@]}" \
  "${image}" ./bin/rails db:prepare

[[ "$(docker wait "${database_gate}")" == "0" ]] || {
  echo "Database preparation gate did not accept the prepared databases" >&2
  exit 1
}
docker rm "${database_gate}" >/dev/null

for solid_table in solid_cache_entries solid_queue_jobs solid_cable_messages; do
  [[ -z "$(docker exec "${database}" psql --username postgres --dbname app_production --tuples-only --no-align --command "SELECT to_regclass('public.${solid_table}')")" ]] || {
    echo "Primary database unexpectedly contains ${solid_table}" >&2
    exit 1
  }
done
for adapter_database_and_table in \
  "app_production_cache solid_cache_entries" \
  "app_production_queue solid_queue_jobs" \
  "app_production_cable solid_cable_messages"; do
  read -r adapter_database adapter_table <<<"${adapter_database_and_table}"
  [[ "$(docker exec "${database}" psql --username postgres --dbname "${adapter_database}" --tuples-only --no-align --command "SELECT to_regclass('public.${adapter_table}')")" == "${adapter_table}" ]] || {
    echo "${adapter_database} is missing ${adapter_table}" >&2
    exit 1
  }
done

docker run --detach --name "${app}" --network "${network}" --publish 127.0.0.1::80 \
  "${web_runtime_environment[@]}" \
  --env WEB_CONCURRENCY=0 \
  "${image}" >/dev/null
wait_for_health "${app}" 120 || exit 1

docker run --detach --name "${worker}" --network "${network}" --no-healthcheck \
  "${worker_runtime_environment[@]}" \
  "${image}" ./bin/jobs >/dev/null

host_port="$(docker port "${app}" 80/tcp | head -1 | awk -F: '{print $NF}')"
base_url="http://127.0.0.1:${host_port}"
assert_http_status 200 "${base_url}/" --header 'Host: render.test'
assert_http_status 200 "${base_url}/" --header 'Host: attacker.test'
assert_http_status 200 "${base_url}/up" --header 'Host: internal-probe'
assert_http_status 200 "${base_url}/ready" --header 'Host: internal-probe'
assert_http_status 404 "${base_url}/production-smoke-missing" --header 'Host: render.test'
assert_enforced_csp "${base_url}/production-smoke-missing" --header 'Host: render.test'

docker exec "${app}" bin/rails runner \
  'key = "production-smoke:cache"; Rails.cache.write(key, ENV.fetch("SMOKE_TOKEN")); abort "Solid Cache failed" unless Rails.cache.read(key) == ENV.fetch("SMOKE_TOKEN")'

docker exec "${app}" bin/rails runner \
  'service = ActiveStorage::Blob.service; abort "Active Storage is not using S3" unless service.is_a?(ActiveStorage::Service::S3Service); abort "Active Storage bucket mismatch" unless service.bucket.name == ENV.fetch("OBJECT_STORAGE_BUCKET")'

cable_before="$(docker exec "${app}" bin/rails runner 'puts SolidCable::Message.count')"
docker exec "${app}" bin/rails runner 'ActionCable.server.broadcast("production-smoke", {ok: true})'
for _ in {1..20}; do
  cable_after="$(docker exec "${app}" bin/rails runner 'puts SolidCable::Message.count')"
  (( cable_after > cable_before )) && break
  sleep 1
done
(( cable_after > cable_before )) || { echo "Solid Cable did not persist a broadcast" >&2; exit 1; }

docker exec "${app}" bin/rails runner \
  '3.times do |index|
    token = "#{ENV.fetch("SMOKE_TOKEN")}-#{index}"
    ProductionSmokeDefaultJob.perform_later(token)
    ProductionSmokeAiJob.perform_later(token)
  end'

# Exercise the web connection budget while the separate worker performs jobs. This
# is deliberately small: enough to catch pool starvation without becoming a
# load test whose timing depends on the CI runner.
request_pids=()
for _ in {1..6}; do
  curl --fail --silent --show-error --header 'Host: internal-probe' "${base_url}/ready" >/dev/null &
  request_pids+=("$!")
done
for request_pid in "${request_pids[@]}"; do
  wait "${request_pid}"
done

for _ in {1..45}; do
  if docker exec "${app}" bin/rails runner \
    'exit(3.times.all? do |index|
      token = "#{ENV.fetch("SMOKE_TOKEN")}-#{index}"
      Rails.cache.read("production-smoke:default:#{token}") == "performed" &&
        Rails.cache.read("production-smoke:ai:#{token}") == "performed"
    end ? 0 : 1)'; then
    job_performed=true
    break
  fi
  sleep 1
done
[[ "${job_performed:-false}" == "true" ]] || { echo "Solid Queue did not perform the smoke job" >&2; exit 1; }

for _ in {1..20}; do
  remaining_smoke_jobs="$(docker exec "${database}" psql --username postgres --dbname app_production_queue \
    --tuples-only --no-align \
    --command "SELECT count(*) FROM solid_queue_jobs WHERE class_name IN ('ProductionSmokeDefaultJob', 'ProductionSmokeAiJob')")"
  [[ "${remaining_smoke_jobs}" == "0" ]] && break
  sleep 0.25
done
[[ "${remaining_smoke_jobs}" == "0" ]] || {
  echo "Solid Queue retained ${remaining_smoke_jobs} successful smoke jobs" >&2
  exit 1
}

echo "Production web and worker booted; isolated Cache, Queue, and Cable databases, S3 storage configuration, and both job lanes passed"
