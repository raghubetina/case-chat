# Operator-facing keys. NOTHING here is required for development. Copy to .env
# (gitignored, loaded by dotenv in dev/test) only when activating something
# locally or reproducing a production setting.

# Activates Rollbar error tracking.
# ROLLBAR_ACCESS_TOKEN=

# Activates Skylight APM (production only).
# SKYLIGHT_AUTHENTICATION=

# Connection pool size (default 8: Puma threads + in-process Solid Queue headroom).
# DB_POOL=8

# Per-IP requests per five-minute perimeter window.
# RACK_ATTACK_LIMIT=300

# Solid Cache budget inside the shared database.
# SOLID_CACHE_MAX_SIZE_MB=64

# Production-shaped knobs, normally set by Render (see DEPLOY.md):
# DATABASE_URL=
# SECRET_KEY_BASE=
# SOLID_QUEUE_IN_PUMA=true
# RACK_TIMEOUT_SERVICE_TIMEOUT=15
# Standard Rails/Puma knobs (defaults are sensible; here for completeness):
# PORT=3000
# RAILS_MAX_THREADS=3
# WEB_CONCURRENCY=0
# RAILS_LOG_LEVEL=info
