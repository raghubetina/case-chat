# Operator-facing keys. NOTHING here is required for development. Copy to .env
# (gitignored, loaded by dotenv in dev/test) only when activating something
# locally or reproducing a production setting.

# Activates Rollbar error tracking.
# ROLLBAR_ACCESS_TOKEN=

# Activates Skylight APM (production only).
# SKYLIGHT_AUTHENTICATION=

# Platform-owned model-provider credentials. Add these to the shared Render
# environment group; they are not stored in Rails credentials.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Durable private documents shared by web and worker. Endpoint is optional for
# AWS S3; set it for an S3-compatible provider. Set path style to true only when
# the provider requires bucket names in URL paths.
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Production database URLs. The four logical databases may share one managed
# PostgreSQL instance; see DEPLOY.md for the one-time setup.
# DATABASE_URL=
# CACHE_DATABASE_URL=
# QUEUE_DATABASE_URL=
# CABLE_DATABASE_URL=

# Per-process connection pools.
# DB_POOL=5
# CACHE_DB_POOL=3
# Render overrides this per service: 2 for web, 7 for the worker.
# QUEUE_DB_POOL=7
# Render overrides this per service: 3 for web, 5 for the worker.
# CABLE_DB_POOL=3

# Per-IP requests per five-minute perimeter window.
# RACK_ATTACK_LIMIT=300

# Solid Cache budget inside its logical database.
# SOLID_CACHE_MAX_SIZE_MB=256

# Dedicated Solid Queue worker threads. QUEUE_DB_POOL must be at least two
# larger than the larger of these values.
# AI_JOB_THREADS=5
# DEFAULT_JOB_THREADS=2

# Production-shaped knobs, normally set by Render (see DEPLOY.md):
# SECRET_KEY_BASE=
# RACK_TIMEOUT_SERVICE_TIMEOUT=15
# Standard Rails/Puma knobs (defaults are sensible; here for completeness):
# PORT=3000
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2
# RAILS_LOG_LEVEL=info
