# Which provider answers as a stakeholder who has no model of their own:
# anthropic | openai | fake. On openai this resolves to the catalogue's default
# model and effort; the other providers get their own defaults.
# Tests always use the fake regardless of this value.
RESPONDER=openai

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Active Storage in development and production. Without it, document uploads
# fall back to disk, which a Render web service loses on every deploy.
CLOUDINARY_URL=

# The passphrase the seeded demo accounts get. Unset, development falls back to
# CaseSeeder::Base::PASSWORD, which is committed to this repository; production
# refuses to seed without it. Tests ignore it so the suite cannot depend on a
# value only one machine has.
# SEED_PASSWORD=
