{
  "name": "app",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": "24.18.x",
    "npm": "11.16.x"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "daisyui": "^5.6.16",
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "node script/build-js.mjs",
    "build:css": "npx --no-install @tailwindcss/cli -i ./app/assets/stylesheets/application.tailwind.css -o ./app/assets/builds/application.css --minify",
    "check": "biome check --error-on-warnings app/javascript app/assets/stylesheets",
    "check:fix": "biome check --write app/javascript app/assets/stylesheets"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "@tailwindcss/cli": "^4.3.2",
    "tailwindcss": "^4.3.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild@0.28.1": true
  }
}
