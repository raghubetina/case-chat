<% descriptor = @referral.created_at.presence || t("foundation_domain.entities.referrals.show.unnamed", id: @referral.id) %>
<% content_for :title, t("foundation_domain.entities.referrals.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.referrals.fields.condition") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @referral.condition %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.referrals.fields.enabled") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @referral.enabled %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.referrals.show.back"), referrals_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.referrals.edit.action"), edit_referral_path(@referral, return_to: referral_path(@referral)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.referrals.destroy.action"), referral_path(@referral),
      method: :delete, params: {return_to: referrals_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.referrals.destroy.confirm")}} %>
  </div>
</section>
