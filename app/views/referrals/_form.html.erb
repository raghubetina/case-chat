<%= form_with model: record,
  scope: :referral,
  url: (record.persisted? ? referral_path(record) : referrals_path),
  method: (record.persisted? ? :patch : :post),
  class: "space-y-6" do |form| %>
  <%= hidden_field_tag :return_to, return_to %>

  <% if record.errors.any? %>
    <section class="alert alert-error" role="alert" aria-labelledby="foundation-form-errors">
      <div>
        <h2 id="foundation-form-errors" class="font-semibold"><%= t("foundation_domain.form.errors.heading") %></h2>
        <ul class="mt-2 list-disc pl-5">
          <% record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <div>
    <%= form.label :condition, I18n.t("foundation_domain.entities.referrals.fields.condition"), class: "label font-medium" %>
    <%= form.text_area :condition, rows: 3, required: true, class: "textarea textarea-bordered w-full" %>
    <% record.errors.full_messages_for(:condition).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div>
    <label class="label cursor-pointer justify-start gap-3">
      <%= form.check_box :enabled, class: "checkbox" %>
      <span class="label-text"><%= I18n.t("foundation_domain.entities.referrals.fields.enabled") %></span>
    </label>
    <% record.errors.full_messages_for(:enabled).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :referring_contact_id, I18n.t("foundation_domain.entities.referrals.fields.referring_contact_id"), class: "label font-medium" %>
    <%= form.select :referring_contact_id, @referring_contact_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
    <% record.errors.full_messages_for(:referring_contact).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :referred_contact_id, I18n.t("foundation_domain.entities.referrals.fields.referred_contact_id"), class: "label font-medium" %>
    <%= form.select :referred_contact_id, @referred_contact_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
    <% record.errors.full_messages_for(:referred_contact).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("foundation_domain.form.cancel"), cancel_to, class: "btn btn-ghost" %>
  </div>
<% end %>
