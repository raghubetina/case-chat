<% content_for :title, t("shell.panes.directory") %>

<%= render layout: "shared/shell", locals: student_shell do %>

  <%= render "shared/pane_header",
        title: t("shell.panes.directory"), aside: t("cases.directory_note") %>

  <div class="scroll-y flex-1 px-4 py-6">
    <div class="mx-auto grid w-full max-w-[1000px] gap-4 sm:grid-cols-2 xl:grid-cols-3">
      <% @directory.each do |contact| %>
        <% conversation = @threads_by_contact[contact.id] %>
        <article id="<%= dom_id(contact) %>" class="@container flex flex-col gap-4 rounded-lg border border-line bg-surface p-4">
          <div class="flex items-start gap-3">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full border border-line bg-wash font-mono text-[15px] font-semibold tracking-normal text-accent">
              <%= initials_for(contact.full_name) %>
            </div>
            <div class="flex min-w-0 flex-col gap-1">
              <span class="font-head text-lg font-semibold leading-tight"><%= contact.full_name %></span>
              <span class="text-base leading-tight text-mute"><%= contact.role_title %></span>
            </div>
          </div>

          <% if contact.description.present? %>
            <p class="text-base text-mute"><%= contact.description %></p>
          <% end %>

          <div class="@max-[380px]:flex-col @max-[380px]:items-stretch mt-auto flex items-center justify-between gap-3 border-t border-line pt-3">
            <span class="text-base text-faint"><%= message_summary(conversation) %></span>
            <% if conversation %>
              <%= link_to t("cases.resume"), thread_path(conversation), class: "btn btn-outline btn-sm" %>
            <% else %>
              <%= button_to t("cases.start_thread"), case_threads_path(@case_study, contact_id: contact.id),
                    class: "btn btn-primary btn-sm" %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  </div>
<% end %>
