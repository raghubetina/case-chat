<% content_for :title, t("shell.search_title") %>

<%= render layout: "shared/shell", locals: student_shell do %>
  <%= render "shared/pane_header", title: t("shell.search_title") %>

  <div class="scroll-y flex-1 px-4 py-6">
    <div class="mx-auto flex w-full max-w-col flex-col gap-6">
      <% if @query.blank? %>
        <p class="text-base text-mute"><%= t("shell.search_prompt") %></p>
      <% else %>
        <p class="text-base text-mute">
          <%= t("shell.search_summary", count: @message_hits.size + @document_hits.size, query: @query) %>
        </p>

        <% @message_hits.each do |message| %>
          <%= link_to thread_path(message.conversation),
                class: "flex flex-col gap-1 rounded-lg border border-line p-3 hover:border-accent" do %>
            <span class="flex items-baseline justify-between gap-2">
              <span class="text-base font-semibold">
                <%= message.from_contact? ? message.conversation.contact.full_name : current_user.full_name %>
              </span>
              <span class="text-sm text-faint"><%= l(message.sent_at, format: :short) if message.sent_at %></span>
            </span>
            <span class="text-base text-mute"><%= highlight(truncate(message.body, length: 180), @query) %></span>
          <% end %>
        <% end %>

        <% @document_hits.each do |document| %>
          <div class="flex items-center gap-3 rounded-lg border border-line p-3">
            <span class="kick flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line text-xs text-accent">
              <%= File.extname(document.file_name).delete(".").upcase.presence || t("threads.file") %>
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="truncate text-base font-medium"><%= highlight(document.file_name, @query) %></span>
              <% if document.description.present? %>
                <span class="truncate text-base text-mute"><%= highlight(document.description, @query) %></span>
              <% end %>
            </span>
            <%= document_link(document, label: t("threads.open_document")) %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
