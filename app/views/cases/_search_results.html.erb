<%# While a search is running the sidebar shows its results in place of the
    navigation, per the Design: you are looking for something, so the sidebar
    stops being a map and becomes the list of what was found. %>
<div class="flex flex-col gap-3">
  <div class="flex items-baseline justify-between gap-2 px-2">
    <span class="kick truncate text-xs text-mute"><%= t("shell.results_for", query: @query) %></span>
    <span class="kick text-xs text-faint"><%= @message_hits.size + @document_hits.size %></span>
  </div>

  <% @message_hits.each do |message| %>
    <%= link_to thread_path(message.conversation),
          class: "flex flex-col gap-1 rounded-md border border-line bg-surface p-3 text-left hover:border-accent" do %>
      <span class="flex items-baseline justify-between gap-2">
        <span class="truncate text-sm font-semibold">
          <%= message.from_contact? ? message.conversation.contact.full_name : current_user.full_name %>
        </span>
        <span class="shrink-0 text-sm text-faint"><%= l(message.sent_at, format: :short) if message.sent_at %></span>
      </span>
      <span class="text-sm text-mute"><%= highlight(truncate(message.body, length: 90), @query) %></span>
    <% end %>
  <% end %>

  <% @document_hits.each do |document| %>
    <%= link_to search_case_path(@case_study, run: run_param, q: @query),
          class: "flex flex-col gap-1 rounded-md border border-line bg-surface p-3 text-left hover:border-accent" do %>
      <span class="flex items-baseline justify-between gap-2">
        <span class="truncate text-sm font-semibold"><%= document.file_name %></span>
        <span class="kick shrink-0 text-xs text-faint"><%= t("threads.file") %></span>
      </span>
      <% if document.description.present? %>
        <span class="text-sm text-mute"><%= highlight(truncate(document.description, length: 90), @query) %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if @message_hits.none? && @document_hits.none? %>
    <p class="px-2 text-sm text-faint"><%= t("shell.no_results") %></p>
  <% end %>
</div>
