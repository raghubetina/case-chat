<% content_for :title, t("shell.panes.background") %>

<%= render layout: "shared/shell", locals: student_shell do %>
  <%= render "shared/pane_header", title: t("shell.panes.background") %>

  <div class="scroll-y flex-1 px-4 py-6">
    <div class="mx-auto flex w-full max-w-col flex-col gap-6">
      <% if @case_study.background.present? %>
        <div class="whitespace-pre-wrap text-base"><%= @case_study.background %></div>
      <% else %>
        <p class="text-base text-mute"><%= t("cases.no_background") %></p>
      <% end %>

      <dl class="flex flex-wrap gap-6 border-t border-line pt-4 text-base">
        <div class="flex flex-col gap-1">
          <dt class="kick text-xs text-mute"><%= t("cases.instructor") %></dt>
          <dd><%= @case_study.author.full_name %></dd>
        </div>
        <% if @case_study.course.present? %>
          <div class="flex flex-col gap-1">
            <dt class="kick text-xs text-mute"><%= t("cases.course") %></dt>
            <dd><%= @case_study.course %></dd>
          </div>
        <% end %>
        <% if @case_study.due_at %>
          <div class="flex flex-col gap-1">
            <dt class="kick text-xs text-mute"><%= t("cases.prepare_by_label") %></dt>
            <dd><%= l(@case_study.due_at, format: :long) %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
<% end %>
