<% content_for :title, t("cases.index.title") %>

<%# Only reached with no enrollments at all — the controller redirects into the
    shell otherwise. There is no case list: the sidebar's switcher is the list. %>
<div class="mx-auto flex max-w-[640px] flex-col gap-8 py-10">
  <div class="flex flex-col gap-2">
    <h1 class="font-head text-xl font-semibold"><%= t("cases.index.empty_heading") %></h1>
    <p class="max-w-prose text-base text-mute"><%= t("cases.index.empty_body") %></p>
  </div>

  <div class="flex flex-col gap-6 rounded-lg border border-line bg-surface p-6">
    <%= render "cases/join_form" %>
  </div>
</div>
