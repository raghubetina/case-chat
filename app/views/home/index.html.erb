<% if request.env.key?("rodauth") && rodauth.logged_in? %>
  <% content_for :title, t("home.signed_in.heading", name: rodauth.rails_account.full_name) %>

  <section class="signed-in-home">
    <div class="signed-in-home__intro">
      <p class="author-eyebrow"><%= t("home.signed_in.eyebrow") %></p>
      <h1><%= t("home.signed_in.heading", name: rodauth.rails_account.full_name) %></h1>
      <p><%= t("home.signed_in.lede") %></p>
    </div>
    <div class="signed-in-home__actions">
      <article class="home-action-card">
        <span class="home-action-card__number" aria-hidden="true"></span>
        <div>
          <h2><%= t("home.signed_in.your_cases_heading") %></h2>
          <p><%= t("home.signed_in.your_cases_lede") %></p>
        </div>
        <%= link_to t("home.signed_in.your_cases_action"), author_cases_path, class: "button button-primary" %>
      </article>
      <article class="home-action-card">
        <span class="home-action-card__number" aria-hidden="true"></span>
        <div>
          <h2><%= t("home.signed_in.new_case_heading") %></h2>
          <p><%= t("home.signed_in.new_case_lede") %></p>
        </div>
        <%= link_to t("home.signed_in.new_case_action"), new_author_case_path, class: "button button-ghost home-action-card__secondary-action" %>
      </article>
    </div>
  </section>
<% else %>
  <% content_for :title, t("home.heading") %>

  <section class="product-home hero-layout">
    <div class="hero-layout-inner">
      <div class="product-home__panel">
        <p class="author-eyebrow"><%= t("home.eyebrow") %></p>
        <h1><%= t("home.public_heading") %></h1>
        <p><%= t("home.lede") %></p>
        <div class="product-home__actions">
          <%= link_to t("home.create_account"), rodauth.create_account_path, class: "button button-primary" %>
          <%= link_to t("home.sign_in"), rodauth.login_path, class: "button button-ghost" %>
        </div>
      </div>
    </div>
  </section>
<% end %>
