<%= form_with model: record,
  scope: :share_rule,
  url: (record.persisted? ? share_rule_path(record) : share_rules_path),
  method: (record.persisted? ? :patch : :post),
  class: "space-y-6" do |form| %>
  <%= hidden_field_tag :return_to, return_to %>

  <% if record.errors.any? %>
    <section class="alert alert-error" role="alert" aria-labelledby="foundation-form-errors">
      <div>
        <h2 id="foundation-form-errors" class="font-semibold"><%= t("foundation_domain.form.errors.heading") %></h2>
        <ul class="mt-2 list-disc pl-5">
          <% record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <div>
    <%= form.label :condition, I18n.t("foundation_domain.entities.share_rules.fields.condition"), class: "label font-medium" %>
    <%= form.text_area :condition, rows: 3, required: true, class: "textarea textarea-bordered w-full" %>
    <% record.errors.full_messages_for(:condition).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div>
    <%= form.label :contact_id, I18n.t("foundation_domain.entities.share_rules.fields.contact_id"), class: "label font-medium" %>
    <%= form.select :contact_id, @contact_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
    <% record.errors.full_messages_for(:contact).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>
  <div>
    <%= form.label :document_id, I18n.t("foundation_domain.entities.share_rules.fields.document_id"), class: "label font-medium" %>
    <%= form.select :document_id, @document_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
    <% record.errors.full_messages_for(:document).each do |message| %>
      <p class="mt-1 text-sm text-error"><%= message %></p>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("foundation_domain.form.cancel"), cancel_to, class: "btn btn-ghost" %>
  </div>
<% end %>
