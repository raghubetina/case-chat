<% descriptor = @share_rule.created_at.presence || t("foundation_domain.entities.share_rules.show.unnamed", id: @share_rule.id) %>
<% content_for :title, t("foundation_domain.entities.share_rules.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.share_rules.fields.condition") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @share_rule.condition %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.share_rules.show.back"), share_rules_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.share_rules.edit.action"), edit_share_rule_path(@share_rule, return_to: share_rule_path(@share_rule)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.share_rules.destroy.action"), share_rule_path(@share_rule),
      method: :delete, params: {return_to: share_rules_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.share_rules.destroy.confirm")}} %>
  </div>
</section>
