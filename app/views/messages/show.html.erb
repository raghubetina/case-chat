<% descriptor = @message.created_at.presence || t("foundation_domain.entities.messages.show.unnamed", id: @message.id) %>
<% content_for :title, t("foundation_domain.entities.messages.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.messages.fields.body") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @message.body %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.messages.fields.sent_at") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @message.sent_at %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.messages.fields.from_contact") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @message.from_contact %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.messages.show.back"), messages_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.messages.edit.action"), edit_message_path(@message, return_to: message_path(@message)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.messages.destroy.action"), message_path(@message),
      method: :delete, params: {return_to: messages_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.messages.destroy.confirm")}} %>
  </div>
</section>
