<% content_for :title, t("auth.change_password.heading") %>
<% current_password_error = rodauth.field_error(rodauth.password_param) %>
<% new_password_error = rodauth.field_error(rodauth.new_password_param) %>

<section class="auth-layout" aria-labelledby="change-password-heading">
  <div class="auth-panel">
    <header class="auth-panel__header">
      <h1 id="change-password-heading"><%= t("auth.change_password.heading") %></h1>
      <p><%= t("auth.change_password.lede") %></p>
    </header>

    <%= form_with url: rodauth.change_password_path, method: :post, data: {turbo: false}, class: "auth-form" do |form| %>
      <% if rodauth.change_password_requires_password? %>
        <div>
          <%= form.label "password", t("auth.fields.current_password"), class: "form-label" %>
          <%= form.password_field rodauth.password_param,
                value: "",
                id: "password",
                autocomplete: rodauth.password_field_autocomplete_value,
                required: true,
                class: class_names("form-input", "form-input-error": current_password_error.present?),
                aria: ({invalid: true, describedby: "password-error"} if current_password_error) %>
          <%= tag.p current_password_error, id: "password-error", class: "form-error" if current_password_error %>
        </div>
      <% end %>

      <div>
        <%= form.label "new-password", t("auth.fields.new_password"), class: "form-label" %>
        <%= form.password_field rodauth.new_password_param,
              value: "",
              id: "new-password",
              autocomplete: "new-password",
              required: true,
              class: class_names("form-input", "form-input-error": new_password_error.present?),
              aria: {invalid: new_password_error.present?, describedby: ["new-password-hint", ("new-password-error" if new_password_error)].compact.join(" ")} %>
        <p id="new-password-hint" class="auth-field-hint"><%= t("auth.fields.password_hint") %></p>
        <%= tag.p new_password_error, id: "new-password-error", class: "form-error" if new_password_error %>
      </div>

      <% if rodauth.require_password_confirmation? %>
        <div>
          <%= form.label "password-confirm", t("auth.fields.confirm_new_password"), class: "form-label" %>
          <%= form.password_field rodauth.password_confirm_param,
                value: "",
                id: "password-confirm",
                autocomplete: "new-password",
                required: true,
                class: "form-input" %>
        </div>
      <% end %>

      <div class="auth-actions">
        <%= form.submit t("auth.change_password.submit"), class: "button button-primary" %>
      </div>
    <% end %>
  </div>
</section>
