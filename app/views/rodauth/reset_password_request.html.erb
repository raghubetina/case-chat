<%= render "panel" do %>
  <%= render "header", lede: t("auth.reset_password_request.lede") %>

  <%= form_with url: rodauth.reset_password_request_path, method: :post, data: {turbo: false}, class: "space-y-5" do |form| %>
    <div class="space-y-1.5">
      <%= form.label rodauth.login_param, rodauth.login_label, class: "label font-medium" %>
      <%= form.email_field rodauth.login_param,
        value: params[rodauth.login_param],
        id: "email",
        autocomplete: "email",
        required: true,
        class: rodauth_input_class(rodauth, rodauth.login_param),
        **rodauth_field_attributes(rodauth, rodauth.login_param) %>
      <%= render "field_error", rodauth:, param_name: rodauth.login_param %>
    </div>

    <%= form.submit rodauth.reset_password_request_button, class: "btn btn-primary w-full" %>
  <% end %>

  <p class="mt-6 text-center text-sm">
    <%= link_to t("auth.actions.back_to_sign_in"), rodauth.login_path, class: "link link-hover" %>
  </p>
<% end %>
