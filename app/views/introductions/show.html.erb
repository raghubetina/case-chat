<% descriptor = @introduction.created_at.presence || t("foundation_domain.entities.introductions.show.unnamed", id: @introduction.id) %>
<% content_for :title, t("foundation_domain.entities.introductions.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.introductions.show.back"), introductions_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.introductions.edit.action"), edit_introduction_path(@introduction, return_to: introduction_path(@introduction)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.introductions.destroy.action"), introduction_path(@introduction),
      method: :delete, params: {return_to: introductions_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.introductions.destroy.confirm")}} %>
  </div>
</section>
