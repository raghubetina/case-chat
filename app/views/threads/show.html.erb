<% content_for :title, @contact.full_name %>
<%= turbo_stream_from @conversation %>

<%= render layout: "shared/shell", locals: student_shell do %>
  <%# The thread's header carries the person, not just their name, so the
      monogram makes it a different shape from the case panes. %>
  <div class="flex h-[57px] shrink-0 items-center gap-3 border-b border-line px-4">
    <button type="button" data-action="drawer#open" data-drawer-target="toggle"
            aria-label="<%= t("shell.open_menu") %>" aria-expanded="false" aria-controls="workspace-sidebar"
            class="-ml-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-mute hover:bg-wash md:hidden">
      <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
    </button>

    <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line bg-wash font-mono text-[11px] font-semibold tracking-normal text-accent">
      <%= initials_for(@contact.full_name) %>
    </div>

    <div class="flex min-w-0 flex-col">
      <h1 class="truncate font-head text-lg font-semibold leading-tight"><%= @contact.full_name %></h1>
      <span class="truncate text-sm text-mute"><%= @contact.role_title %></span>
    </div>
  </div>

  <div role="log" aria-live="polite"
       aria-label="<%= t("threads.log_label", name: @contact.full_name) %>"
       class="scroll-y flex flex-1 flex-col gap-6 px-4 py-6"
       data-controller="autoscroll" data-autoscroll-target="container">
    <div id="transcript" class="mx-auto flex w-full max-w-col flex-col gap-6">
      <%# Removed by the send response; otherwise "nothing yet" sits above
          the conversation that just started. %>
      <% if @messages.empty? %>
        <p id="thread_empty" class="text-sm text-mute"><%= t("threads.empty", name: @contact.full_name) %></p>
      <% end %>
      <%= render partial: "threads/message",
            collection: @messages, as: :message, locals: {streaming: false} %>
    </div>
  </div>

  <%= render "threads/composer", conversation: @conversation %>
<% end %>
