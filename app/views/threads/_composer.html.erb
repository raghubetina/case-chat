<div id="composer" class="composer shrink-0 border-t border-line">
  <%# The rule spans the pane, the field does not: max-w-col matches the
      transcript above, so you type under the words you are answering. %>
  <div class="mx-auto w-full max-w-col px-4 py-3">
    <% if conversation.enrollment.current? %>
      <%# scope: :message is load-bearing. Without it form_with emits name="body",
          while the controller reads params[:message][:body] — so every send 400s
          and Turbo discards the response, which looks exactly like nothing
          happening. The system test types and clicks Send for real; an
          integration test that hand-builds the params cannot catch this. %>
      <%= form_with url: thread_messages_path(conversation), method: :post, scope: :message,
            id: "composer_form",
            data: {controller: "composer", action: "turbo:submit-end->composer#clear"} do |form| %>
        <div class="flex items-end gap-2 rounded-lg border border-line bg-surface p-2">
          <%= form.text_area :body,
                rows: 1,
                required: true,
                "aria-label": t("threads.compose_label", name: conversation.contact.full_name),
                placeholder: t("threads.compose_placeholder", name: conversation.contact.full_name),
                class: "max-h-[160px] min-h-[40px] flex-1 resize-none border-0 bg-transparent px-2 py-2 text-base leading-snug outline-none",
                data: {composer_target: "input", action: "input->composer#grow keydown->composer#submitOnEnter"} %>
          <%= form.submit t("threads.send"), class: "btn btn-primary h-10 shrink-0" %>
        </div>
      <% end %>
    <% else %>
      <%# The only way back to a live composer, and until now the copy named it
          without offering it. Restarting is a write, so it is a button. %>
      <div class="flex flex-wrap items-center gap-3">
        <p class="text-sm text-mute"><%= t("threads.run_closed") %></p>
        <%= button_to t("cases.restart.action"), restart_case_path(conversation.enrollment.case_study_id),
              form: {data: {turbo_confirm: t("cases.restart.confirm")}},
              class: "btn btn-outline btn-sm" %>
      </div>
    <% end %>
  </div>
</div>
