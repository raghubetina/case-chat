<% content_for :title, t("author.stakeholders.edit.title", name: @stakeholder.name) %>

<section class="author-editor stakeholder-editor">
  <div class="author-editor__intro">
    <%= link_to t("author.stakeholders.form.back"), author_case_stakeholders_path(@case), class: "author-back-link" %>
    <p class="author-eyebrow"><%= t("author.stakeholders.edit.eyebrow", case_title: @case.title) %></p>
    <h1><%= t("author.stakeholders.edit.heading", name: @stakeholder.name) %></h1>
    <p><%= t("author.stakeholders.edit.lede") %></p>
  </div>

  <div class="author-editor__panel">
    <%= render "form", case_record: @case, stakeholder: @stakeholder, submit_label: t("author.stakeholders.edit.submit") %>
  </div>
</section>
