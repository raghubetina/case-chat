<% content_for :title, t("author.contacts.add") %>

<div class="mx-auto flex max-w-[640px] flex-col gap-6 py-10">
  <h1 class="font-head text-xl font-semibold"><%= t("author.contacts.add") %></h1>

  <%= form_with model: @contact, url: author_case_contacts_path(@case_study), class: "flex flex-col gap-6" do |form| %>
    <% if @contact.errors.any? %>
      <div class="alert alert-error" role="alert">
        <ul class="list-disc pl-5">
          <% @contact.errors.full_messages.each do |message| %><li><%= message %></li><% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex flex-col gap-2">
      <%= form.label :full_name, t("author.contacts.fields.full_name"), class: "kick text-xs text-mute" %>
      <%= form.text_field :full_name, required: true, class: "input input-bordered w-full" %>
    </div>
    <div class="flex flex-col gap-2">
      <%= form.label :role_title, t("author.contacts.fields.role_title"), class: "kick text-xs text-mute" %>
      <%= form.text_field :role_title, required: true, class: "input input-bordered w-full" %>
    </div>
    <div class="flex flex-col gap-2">
      <%= form.label :system_prompt, t("author.contacts.fields.system_prompt"), class: "kick text-xs text-mute" %>
      <%= form.text_area :system_prompt, rows: 10, required: true, class: "textarea textarea-bordered w-full font-mono text-sm" %>
    </div>
    <label class="label cursor-pointer justify-start gap-3">
      <%= form.check_box :in_starting_directory, class: "checkbox" %>
      <span class="label-text"><%= t("author.contacts.fields.in_starting_directory") %></span>
    </label>

    <div><%= form.submit t("author.contacts.create"), class: "btn btn-primary" %></div>
  <% end %>
</div>
