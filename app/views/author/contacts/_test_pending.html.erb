<%# Matches the settled contact turn below, so the swap does not move the text. %>
<div id="<%= dom_id(contact, :test_pending) %>" class="flex flex-col gap-1">
  <span class="kick text-xs text-mute"><%= contact.full_name %></span>
  <div class="max-w-[85%] whitespace-pre-wrap break-words rounded-lg border border-line bg-surface px-3 py-2 text-sm"
       id="<%= dom_id(contact, :test_pending_body) %>"></div>
</div>
