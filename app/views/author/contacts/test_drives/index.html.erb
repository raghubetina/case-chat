<% content_for :title, t("author.test_drive.board_title", name: @contact.full_name) %>

<%= render layout: "shared/shell", locals: author_shell do %>
  <%= render "shared/pane_header",
        title: t("author.test_drive.board_title", name: @contact.full_name),
        actions: link_to(t("author.test_drive.back_to_person"),
          edit_author_case_contact_path(@case_study, @contact),
          class: "btn btn-outline btn-sm") %>

  <% if @drives.empty? %>
    <div class="scroll-y flex-1 p-6 lg:p-8">
      <div class="mx-auto flex max-w-col flex-col items-center gap-2 rounded-lg border border-dashed border-line p-10 text-center">
        <h2 class="font-head text-lg font-semibold"><%= t("author.test_drive.board_empty_heading") %></h2>
        <p class="max-w-prose text-sm text-mute"><%= t("author.test_drive.board_empty_body") %></p>
      </div>
    </div>
  <% else %>
    <%# The board: one column per run, the row scrolling sideways and each
        column scrolling on its own, so two answers can be read in step rather
        than one pushing the other off the screen. min-h-0 on both axes is what
        lets a flex child scroll instead of growing its parent. %>
    <div class="flex min-h-0 flex-1 gap-4 overflow-x-auto p-4 lg:p-6">
      <% @drives.each do |drive| %>
        <% cost = @costs[drive.id] %>
        <section class="flex min-h-0 w-[360px] shrink-0 flex-col rounded-lg border border-line bg-surface">
          <header class="flex shrink-0 flex-col gap-1 border-b border-line px-4 py-3">
            <div class="flex items-baseline justify-between gap-2">
              <span class="kick text-xs text-accent">
                <%= cost&.dig(:models).presence&.then { |ids|
                      ids.split(", ").map { |id| ModelCatalogue.find(id)&.label || id }.join(", ")
                    } || t("author.test_drive.board_no_model") %>
              </span>
              <span class="kick text-xs text-faint"><%= cost&.dig(:efforts) %></span>
            </div>
            <span class="text-xs text-mute">
              <%= l(drive.created_at, format: :short) %>
              <% if cost %>
                · <%= t("author.test_drive.board_tokens", count: number_with_delimiter(cost[:tokens])) %>
                · <%= money(cost[:cost], unknown: "—") %>
              <% end %>
            </span>
            <%# A prompt edited since the run is the other reason two columns
                differ, and the one nobody remembers. %>
            <% if drive.stale?(@contact) %>
              <span class="kick text-xs text-error"><%= t("author.test_drive.board_stale") %></span>
            <% end %>
          </header>

          <%# The prompt this run actually used, which is the thing being
              changed between runs and so the thing two columns are being read
              to compare. Collapsed, because the answers are what you scan
              first and a prompt is long enough to push them off the screen.

              <details> rather than a Stimulus toggle: it opens without
              JavaScript, and the summary is already a button to a screen
              reader. %>
          <details class="shrink-0 border-b border-line">
            <summary class="kick cursor-pointer px-4 py-2 text-xs text-mute marker:text-faint">
              <%= t("author.test_drive.board_prompt") %>
            </summary>
            <div class="flex flex-col gap-2 px-4 pb-3">
              <% if drive.system_prompt.nil? %>
                <%# Drives from before a run recorded what it was given. %>
                <p class="text-sm text-faint"><%= t("author.test_drive.board_prompt_missing") %></p>
              <% else %>
                <p class="text-xs text-mute">
                  <%= drive.role_title.presence || t("author.test_drive.board_no_role") %>
                  ·
                  <%= drive.knows_case_background ?
                        t("author.test_drive.board_with_background") :
                        t("author.test_drive.board_without_background") %>
                </p>
                <%# The prompt is the author's own text and often long, so it
                    scrolls inside the column rather than stretching it. %>
                <pre class="scroll-y max-h-64 whitespace-pre-wrap break-words rounded-md bg-wash p-3 font-mono text-xs leading-relaxed"><%= drive.system_prompt %></pre>
              <% end %>
            </div>
          </details>

          <div class="scroll-y flex min-h-0 flex-1 flex-col gap-6 p-4">
            <% drive.turns.each do |turn| %>
              <%= render "author/contacts/test_turn", turn: turn, contact: @contact,
                    author_name: current_user.full_name %>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% end %>
<% end %>
