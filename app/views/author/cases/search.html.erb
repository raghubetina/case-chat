<% content_for :title, t("shell.search_title") %>

<%= render layout: "shared/shell", locals: author_shell do %>
  <%= render "shared/pane_header", title: t("shell.search_title") %>

  <div class="scroll-y flex-1 p-6 lg:p-8">
    <div class="mx-auto flex w-full max-w-col flex-col gap-6">
      <% if @query.blank? %>
        <p class="text-base text-mute"><%= t("author.shell.search_prompt") %></p>
      <% else %>
        <p class="text-base text-mute">
          <%= t("shell.search_summary", count: @contact_hits.size + @document_hits.size, query: @query) %>
        </p>

        <% @contact_hits.each do |contact| %>
          <%= link_to edit_author_case_contact_path(@case_study, contact),
                class: "flex flex-col gap-2 rounded-lg border border-line p-4 hover:border-accent" do %>
            <span class="flex items-baseline gap-2">
              <span class="font-head text-lg font-semibold"><%= highlight(contact.full_name, @query) %></span>
              <span class="text-base text-mute"><%= contact.role_title %></span>
            </span>
            <%# The prompt is where a match usually lands, and prompts run to
                thousands of words, so show the window around the hit. Falling
                back to the opening covers a match on the name or role. %>
            <% window = excerpt(contact.system_prompt, @query, radius: 140) %>
            <span class="font-mono text-sm text-mute">
              <%= highlight(window.presence || truncate(contact.system_prompt, length: 300), @query) %>
            </span>
          <% end %>
        <% end %>

        <% @document_hits.each do |document| %>
          <div class="flex items-center gap-3 rounded-lg border border-line p-3">
            <span class="kick flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-line text-xs text-accent">
              <%= File.extname(document.file_name).delete(".").upcase.presence || t("threads.file") %>
            </span>
            <span class="flex min-w-0 flex-1 flex-col gap-1">
              <span class="truncate text-base font-medium"><%= highlight(document.file_name, @query) %></span>
              <% if document.description.present? %>
                <span class="truncate text-base text-mute"><%= highlight(document.description, @query) %></span>
              <% end %>
            </span>
            <%= link_to t("author.documents.title"), author_case_documents_path(@case_study), class: "btn btn-outline btn-sm" %>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
