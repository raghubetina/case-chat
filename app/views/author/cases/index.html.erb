<% content_for :title, t("author.cases.index_title") %>

<%# Only reached with nothing authored — the controller redirects into the shell
    otherwise. The sidebar's switcher is the list of cases. %>
<div class="mx-auto flex max-w-[640px] flex-col gap-8 py-10">
  <div class="flex flex-col gap-2">
    <h1 class="font-head text-xl font-semibold"><%= t("author.cases.empty_heading") %></h1>
    <p class="max-w-prose text-base text-mute"><%= t("author.cases.empty_body") %></p>
  </div>

  <div><%= link_to t("author.cases.new"), new_author_case_path, class: "btn btn-primary" %></div>
</div>
