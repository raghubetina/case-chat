<% content_for :title, t("author.usage.title") %>

<%= render layout: "shared/shell", locals: author_shell do %>
  <%= render "shared/pane_header", title: t("author.usage.title") %>

  <div class="scroll-y flex-1 p-6 lg:p-8">
    <div class="mx-auto flex w-full max-w-[1120px] flex-col gap-8">
      <% if @report.any_calls? %>
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          <div class="flex flex-col gap-1 rounded-lg border border-line bg-surface p-4">
            <span class="kick text-xs text-mute"><%= t("author.usage.replies") %></span>
            <span class="font-head text-xl font-semibold"><%= number_with_delimiter(@report.reply_totals.tokens) %></span>
            <span class="text-xs text-faint"><%= t("author.usage.calls", count: @report.reply_totals.calls) %></span>
          </div>
          <div class="flex flex-col gap-1 rounded-lg border border-line bg-surface p-4">
            <span class="kick text-xs text-mute"><%= t("author.usage.rehearsals") %></span>
            <span class="font-head text-xl font-semibold"><%= number_with_delimiter(@report.rehearsal_totals.tokens) %></span>
            <span class="text-xs text-faint"><%= t("author.usage.calls", count: @report.rehearsal_totals.calls) %></span>
          </div>
          <div class="flex flex-col gap-1 rounded-lg border border-line bg-surface p-4">
            <span class="kick text-xs text-mute"><%= t("author.usage.tokens_per_run") %></span>
            <span class="font-head text-xl font-semibold">
              <%= @report.tokens_per_run ? number_with_delimiter(@report.tokens_per_run) : "—" %>
            </span>
          </div>
          <div class="flex flex-col gap-1 rounded-lg border border-line bg-surface p-4">
            <span class="kick text-xs text-mute"><%= t("author.usage.cost") %></span>
            <span class="font-head text-xl font-semibold">
              <%= money(@report.cost, unknown: t("author.usage.cost_unknown")) %>
            </span>
          </div>
        </div>

        <%# Per student, per conversation, per cohort. Per stakeholder answers a
            milder question and stays only where it is the sole key available:
            a rehearsal has no student and no thread to belong to. %>
        <section class="flex flex-col gap-4">
          <h2 class="font-head text-lg font-semibold"><%= t("author.usage.students") %></h2>

          <% if @report.student_rows.any? %>
            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
              <table class="w-full border-collapse text-sm">
                <caption class="sr-only"><%= t("author.usage.students_caption") %></caption>
                <thead>
                  <tr class="border-b border-line">
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.student") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.runs") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.threads") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.tokens") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.cost") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @report.student_rows.each do |row| %>
                    <tr class="border-b border-line last:border-0">
                      <td class="px-4 py-3 font-semibold"><%= row.user.full_name %></td>
                      <td class="px-4 py-3 text-right text-mute"><%= row.runs %></td>
                      <td class="px-4 py-3 text-right text-mute"><%= row.threads %></td>
                      <td class="px-4 py-3 text-right"><%= number_with_delimiter(row.totals.tokens) %></td>
                      <td class="px-4 py-3 text-right"><%= money(row.cost, unknown: "—") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="max-w-prose text-sm text-mute"><%= t("author.usage.no_student_calls") %></p>
          <% end %>
        </section>

        <% if @report.thread_rows.any? %>
          <section class="flex flex-col gap-4">
            <h2 class="font-head text-lg font-semibold"><%= t("author.usage.threads_heading") %></h2>

            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
              <table class="w-full border-collapse text-sm">
                <caption class="sr-only"><%= t("author.usage.threads_caption") %></caption>
                <thead>
                  <tr class="border-b border-line">
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.student") %></th>
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.thread_with") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.tokens") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.cache_rate") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.cost") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @report.thread_rows.each do |row| %>
                    <tr class="border-b border-line last:border-0">
                      <td class="px-4 py-3"><%= row.user.full_name %></td>
                      <td class="px-4 py-3">
                        <span class="block font-semibold"><%= row.contact.full_name %></span>
                        <span class="block text-xs text-mute"><%= row.contact.role_title %></span>
                      </td>
                      <td class="px-4 py-3 text-right"><%= number_with_delimiter(row.totals.tokens) %></td>
                      <td class="px-4 py-3 text-right"><%= (row.totals.cache_hit_rate * 100).round %>%</td>
                      <td class="px-4 py-3 text-right"><%= money(row.cost, unknown: "—") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>

        <% if @report.drive_rows.any? %>
          <section class="flex flex-col gap-4">
            <h2 class="font-head text-lg font-semibold"><%= t("author.usage.test_drives") %></h2>
            <p class="max-w-prose text-sm text-mute"><%= t("author.usage.rehearsals_note") %></p>

            <div class="overflow-x-auto rounded-lg border border-line bg-surface">
              <table class="w-full border-collapse text-sm">
                <caption class="sr-only"><%= t("author.usage.test_drives_caption") %></caption>
                <thead>
                  <tr class="border-b border-line">
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.stakeholder") %></th>
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.model") %></th>
                    <th scope="col" class="kick px-4 py-3 text-left text-xs text-mute"><%= t("author.usage.run_started") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.tokens") %></th>
                    <th scope="col" class="kick px-4 py-3 text-right text-xs text-mute"><%= t("author.usage.cost") %></th>
                  </tr>
                </thead>
                <tbody>
                  <%# One row per run, so the same question asked of two models
                      can be read side by side rather than added together. %>
                  <% @report.drive_rows.each do |row| %>
                    <tr class="border-b border-line last:border-0">
                      <td class="px-4 py-3">
                        <span class="block font-semibold"><%= row.contact&.full_name %></span>
                        <span class="block text-xs text-mute"><%= row.contact&.role_title %></span>
                      </td>
                      <td class="px-4 py-3 text-mute">
                        <%= row.models.map { |id, effort|
                              [ModelCatalogue.find(id)&.label || id, effort].compact.join(" · ")
                            }.join(", ") %>
                      </td>
                      <td class="px-4 py-3 text-mute">
                        <%= row.test_drive ? l(row.test_drive.created_at, format: :short) : "—" %>
                      </td>
                      <td class="px-4 py-3 text-right"><%= number_with_delimiter(row.totals.tokens) %></td>
                      <td class="px-4 py-3 text-right"><%= money(row.cost, unknown: "—") %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </section>
        <% end %>

        <p class="max-w-prose text-sm text-mute"><%= t("author.usage.cost_note") %></p>
      <% else %>
        <div class="flex flex-col items-center gap-2 rounded-lg border border-dashed border-line p-10 text-center">
          <h2 class="font-head text-lg font-semibold"><%= t("author.usage.empty_heading") %></h2>
          <p class="max-w-prose text-sm text-mute"><%= t("author.usage.empty_body") %></p>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
