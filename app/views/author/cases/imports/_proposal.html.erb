<% existing_names = Contact.where(case_study_id: case_study.id).pluck(:full_name).map(&:downcase).to_set %>
<div id="<%= dom_id(case_draft, :proposal) %>" class="flex flex-col gap-6">
  <% if case_draft.drafting? %>
    <div class="flex items-center gap-4 rounded-lg border border-line bg-surface p-6">
      <span class="loading loading-dots loading-md text-accent" aria-hidden="true"></span>
      <span class="flex flex-col gap-1">
        <span class="text-base font-medium"><%= t("author.imports.working") %></span>
        <span class="text-sm text-mute"><%= t("author.imports.working_note") %></span>
      </span>
    </div>
  <% elsif case_draft.failed? %>
    <div class="flex flex-col gap-3 rounded-lg border border-error bg-surface p-6">
      <span class="text-base font-medium"><%= t("author.imports.failed") %></span>
      <span class="text-sm text-mute"><%= t("author.imports.failed_note") %></span>
    </div>
  <% elsif draft %>
    <section class="flex flex-col gap-6 rounded-lg border border-accent bg-surface p-6">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 class="font-head text-lg font-semibold"><%= t("author.imports.proposed") %></h2>
        <span class="text-sm text-mute"><%= t("author.imports.proposed_note") %></span>
      </div>

      <% if draft.notes.any? %>
        <div class="flex flex-col gap-2 rounded-lg border border-line bg-wash p-4">
          <span class="kick text-xs text-mute"><%= t("author.imports.notes") %></span>
          <ul class="flex list-disc flex-col gap-2 pl-5 text-sm text-mute">
            <% draft.notes.each do |note| %><li><%= note %></li><% end %>
          </ul>
        </div>
      <% end %>

      <div class="flex flex-col">
        <div class="flex flex-wrap items-start gap-4 border-t border-line py-3">
          <span class="kick w-[110px] shrink-0 pt-1 text-xs text-mute"><%= t("author.cases.fields.title") %></span>
          <span class="min-w-[220px] flex-1 text-base"><%= draft.title %></span>
        </div>
        <% if draft.course.present? %>
          <div class="flex flex-wrap items-start gap-4 border-t border-line py-3">
            <span class="kick w-[110px] shrink-0 pt-1 text-xs text-mute"><%= t("author.cases.fields.course") %></span>
            <span class="min-w-[220px] flex-1 text-base"><%= draft.course %></span>
          </div>
        <% end %>
        <div class="flex flex-wrap items-start gap-4 border-t border-line py-3">
          <span class="kick w-[110px] shrink-0 pt-1 text-xs text-mute"><%= t("author.cases.fields.background") %></span>
          <span class="min-w-[220px] flex-1 whitespace-pre-wrap text-base text-mute"><%= draft.background %></span>
        </div>
        <div class="flex flex-wrap items-start gap-4 border-y border-line py-3">
          <span class="kick w-[110px] shrink-0 pt-1 text-xs text-mute"><%= t("author.cases.fields.assignment") %></span>
          <span class="min-w-[220px] flex-1 whitespace-pre-wrap text-base text-mute"><%= draft.assignment %></span>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="kick text-xs text-accent"><%= t("author.cases.cast") %></h3>
        <div class="flex flex-col">
          <% draft.contacts.each do |contact| %>
            <div class="flex flex-col gap-3 border-t border-line py-4">
              <div class="flex flex-wrap items-start gap-4">
                <span class="flex w-[170px] shrink-0 flex-col">
                  <span class="text-base font-medium"><%= contact.full_name %></span>
                  <span class="text-base text-mute"><%= contact.role_title %></span>
                </span>
                <span class="min-w-[200px] flex-1 text-sm text-mute"><%= contact.description %></span>
                <span class="flex shrink-0 flex-wrap gap-2">
                  <% if contact.in_starting_directory %>
                    <span class="kick rounded-md bg-soft px-2 py-1 text-xs text-accent"><%= t("author.cases.in_starting") %></span>
                  <% end %>
                  <% if existing_names.include?(contact.full_name.downcase) %>
                    <span class="kick rounded-md bg-wash px-2 py-1 text-xs text-error"><%= t("author.imports.will_overwrite") %></span>
                  <% end %>
                </span>
              </div>
              <details class="rounded-lg border border-line bg-wash">
                <summary class="cursor-pointer px-4 py-2 text-sm font-medium">
                  <%= t("author.imports.read_prompt", name: contact.full_name) %>
                </summary>
                <p class="whitespace-pre-wrap px-4 pb-4 pt-1 text-sm text-mute"><%= contact.system_prompt %></p>
              </details>
            </div>
          <% end %>
        </div>
      </div>

      <div class="flex flex-col gap-3">
        <h3 class="kick text-xs text-accent"><%= t("author.imports.proposed_referrals") %></h3>
        <div class="flex flex-col">
          <% draft.referrals.each do |referral| %>
            <div class="flex flex-wrap items-center gap-4 border-t border-line py-3">
              <span class="w-[280px] shrink-0 text-base"><%= referral.from_name %> &rarr; <%= referral.to_name %></span>
              <span class="min-w-[200px] flex-1 text-sm text-mute"><%= referral.condition %></span>
            </div>
          <% end %>
          <% if draft.referrals.empty? %>
            <p class="border-t border-line py-3 text-sm text-error"><%= t("author.imports.no_referrals") %></p>
          <% end %>
        </div>
      </div>

      <% if draft.share_rules.any? %>
        <div class="flex flex-col gap-3">
          <h3 class="kick text-xs text-accent"><%= t("author.imports.proposed_shares") %></h3>
          <div class="flex flex-col">
            <% draft.share_rules.each do |rule| %>
              <div class="flex flex-wrap items-center gap-4 border-t border-line py-3">
                <span class="w-[240px] shrink-0 truncate text-base"><%= rule.file_name %></span>
                <span class="min-w-[180px] flex-1 text-sm text-mute">
                  <%= t("author.imports.share_summary", contact: rule.contact_name, condition: rule.condition) %>
                </span>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if existing_names.intersect?(draft.contacts.map { |contact| contact.full_name.downcase }.to_set) %>
        <p class="rounded-lg border border-error bg-wash p-4 text-sm text-mute">
          <%= t("author.imports.overwrite_warning") %>
        </p>
      <% end %>

      <div class="flex flex-wrap items-center gap-3 border-t border-line pt-6">
        <%= button_to t("author.imports.accept"), author_case_import_path(case_study, accept: 1),
              method: :post, class: "btn btn-primary" %>
        <span class="text-sm text-mute"><%= t("author.imports.accept_note") %></span>
      </div>
    </section>
  <% end %>
</div>
