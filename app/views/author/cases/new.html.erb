<% content_for :title, t("author.cases.new") %>

<% if @case_study %>
  <%# Inside the shell of the case you were last in: the switcher offers "New
      case", so creating one is a move within the app, not a step outside it. %>
  <%= render layout: "shared/shell", locals: author_shell do %>
    <%= render "shared/pane_header", title: t("author.cases.new") %>

    <div class="scroll-y flex-1 p-6 lg:p-8">
      <div class="mx-auto flex w-full max-w-[640px] flex-col gap-6">
        <%= render "author/cases/new_form" %>
      </div>
    </div>
  <% end %>
<% else %>
  <%# Your first case: there is nothing to draw a shell around yet. %>
  <div class="mx-auto flex max-w-[640px] flex-col gap-6 py-10">
    <h1 class="font-head text-xl font-semibold"><%= t("author.cases.new") %></h1>
    <%= render "author/cases/new_form" %>
  </div>
<% end %>
