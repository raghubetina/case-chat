<%# While a search is running the sidebar shows results in place of the cast,
    per the Design. Prompt text is searched but never shown here: it is long and
    would bury the name you are looking for. %>
<div class="flex flex-col gap-3">
  <div class="flex items-baseline justify-between gap-2 px-2">
    <span class="kick truncate text-xs text-mute"><%= t("shell.results_for", query: @query) %></span>
    <span class="kick text-xs text-faint"><%= @contact_hits.size + @document_hits.size %></span>
  </div>

  <% @contact_hits.each do |contact| %>
    <%= link_to edit_author_case_contact_path(@case_study, contact),
          class: "flex items-center gap-3 rounded-md border border-line bg-surface p-3 text-left hover:border-accent" do %>
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line font-mono text-[11px] font-semibold tracking-normal text-accent">
        <%= initials_for(contact.full_name) %>
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="truncate text-sm font-semibold"><%= highlight(contact.full_name, @query) %></span>
        <span class="truncate text-sm text-mute"><%= contact.role_title %></span>
      </span>
    <% end %>
  <% end %>

  <% @document_hits.each do |document| %>
    <%= link_to author_case_documents_path(@case_study),
          class: "flex flex-col gap-1 rounded-md border border-line bg-surface p-3 text-left hover:border-accent" do %>
      <span class="flex items-baseline justify-between gap-2">
        <span class="truncate text-sm font-semibold"><%= highlight(document.file_name, @query) %></span>
        <span class="kick shrink-0 text-xs text-faint"><%= t("threads.file") %></span>
      </span>
      <% if document.description.present? %>
        <span class="text-sm text-mute"><%= highlight(truncate(document.description, length: 90), @query) %></span>
      <% end %>
    <% end %>
  <% end %>

  <% if @contact_hits.none? && @document_hits.none? %>
    <p class="px-2 text-sm text-faint"><%= t("shell.no_results") %></p>
  <% end %>
</div>
