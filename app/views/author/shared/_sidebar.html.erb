<%# The author's sidebar: the case being built, and its cast. Same shape as the
    student's, different contents — the author navigates by who they are
    writing, the student by who they have met. %>
<nav id="workspace-sidebar" aria-label="<%= t("author.shell.sidebar_label") %>"
     class="sidebar-col hidden min-h-0 flex-col overflow-hidden border-r border-line bg-wash md:flex">

  <div class="flex h-[57px] shrink-0 items-center border-b border-line px-4">
    <div class="flex w-full items-center gap-2">
      <div class="dropdown min-w-0 flex-1">
        <button type="button"
                class="-mx-2 flex w-full min-w-0 items-center gap-2 rounded-md px-2 py-1 text-left hover:bg-surface">
          <span class="truncate font-head text-lg font-semibold leading-tight"><%= @case_study.title %></span>
          <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="ml-auto shrink-0 text-mute">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </button>

        <%# No `flex` on .dropdown-content: daisyUI closes the dropdown with
            `display:none` from inside a cascade layer, and a Tailwind display
            utility is unlayered, so it wins and the panel stays open forever. %>
        <div aria-label="<%= t("shell.your_cases") %>" class="dropdown-content z-30 mt-1 w-[240px] rounded-lg border border-line bg-surface py-1 shadow">
          <span class="kick block px-3 py-2 text-xs text-mute"><%= t("author.shell.your_cases") %></span>
          <% authored_cases.each do |other| %>
            <% here = other.id == @case_study.id %>
            <%= link_to edit_author_case_path(other),
                  class: "flex items-center gap-2 px-3 py-2 text-sm hover:bg-wash #{"font-medium" if here}",
                  aria: {current: ("true" if here)} do %>
              <span class="truncate"><%= other.title %></span>
              <% unless other.published? %>
                <span class="kick ml-auto shrink-0 text-xs text-faint"><%= t("author.cases.draft_badge") %></span>
              <% end %>
            <% end %>
          <% end %>
          <span class="my-1 block h-px bg-line"></span>
          <%= link_to t("author.cases.new"), new_author_case_path,
                class: "block px-3 py-2 text-sm hover:bg-wash" %>
        </div>
      </div>

      <button type="button" data-action="drawer#close" aria-label="<%= t("shell.close_menu") %>"
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-mute hover:bg-surface md:hidden">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <div class="scroll-y flex flex-1 flex-col gap-4 p-2">
    <% if @query.present? %>
      <%= render "author/shared/search_results" %>
    <% else %>
      <div class="flex flex-col gap-1">
        <span class="kick flex h-8 items-center px-2 text-xs text-mute"><%= t("shell.case_section") %></span>
        <%= sidebar_row t("author.shell.setup"), edit_author_case_path(@case_study) %>
        <%= sidebar_row t("author.shell.files"), author_case_documents_path(@case_study), count: authoring_documents.size %>
        <%= sidebar_row t("author.shell.import"), new_author_case_import_path(@case_study) %>
        <%= sidebar_row t("author.shell.cohort"), author_case_cohort_path(@case_study), count: authoring_enrollment_count %>
      </div>

      <div class="flex flex-col gap-1">
        <div class="flex h-8 items-center gap-2 px-2">
          <span class="kick text-xs text-mute"><%= t("author.shell.cast") %></span>
          <span class="kick text-xs text-faint"><%= authoring_cast.size %></span>
          <%= link_to new_author_case_contact_path(@case_study),
                aria: {label: t("author.contacts.add")},
                class: "ml-auto flex h-6 w-6 shrink-0 items-center justify-center rounded-md text-mute hover:bg-surface hover:text-ink" do %>
            <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 5v14M5 12h14" /></svg>
          <% end %>
        </div>

        <% authoring_cast.each do |contact| %>
          <% path = edit_author_case_contact_path(@case_study, contact) %>
          <% here = current_page?(path) %>
          <%= link_to path, aria: {current: ("page" if here)},
                class: "flex items-center gap-3 rounded-md px-2 py-2 text-left #{here ? "row-on" : "row-off"}" do %>
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-line bg-surface font-mono text-[11px] font-semibold tracking-normal text-accent">
              <%= initials_for(contact.full_name) %>
            </span>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="truncate text-sm font-medium"><%= contact.full_name %></span>
              <span class="truncate text-sm text-mute"><%= contact.role_title %></span>
            </span>
            <%# Nobody can reach them: not in the starting directory and nobody
                refers them. Publishing is blocked until this is gone. %>
            <% if unreachable_ids.include?(contact.id) %>
              <span class="kick shrink-0 text-xs text-accent"><%= t("author.shell.unreachable") %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</nav>
