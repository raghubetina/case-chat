<h1><%= t("mailers.rodauth.reset_password.heading") %></h1>
<p><%= t("mailers.rodauth.greeting", name: @account.full_name) %></p>
<p><%= t("mailers.rodauth.reset_password.body") %></p>
<p><%= link_to t("mailers.rodauth.reset_password.action"), @rodauth.reset_password_email_link, class: "email-button" %></p>
<p class="email-muted"><%= t("mailers.rodauth.not_requested") %></p>
<p class="email-muted email-url"><%= @rodauth.reset_password_email_link %></p>
