<%# Every pane wears the same 57px header, aligned with the sidebar's own, so
    the two columns read as one bar. The hamburger is the only way back to the
    sidebar under md, where the sidebar is off-screen. %>
<div class="flex h-[57px] shrink-0 items-center gap-3 border-b border-line px-4">
  <button type="button" data-action="drawer#open" data-drawer-target="toggle"
          aria-label="<%= t("shell.open_menu") %>" aria-expanded="false" aria-controls="workspace-sidebar"
          class="-ml-2 flex h-8 w-8 shrink-0 items-center justify-center rounded-md text-mute hover:bg-wash md:hidden">
    <svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h18M3 12h18M3 18h18" /></svg>
  </button>

  <h1 class="truncate font-head text-lg font-semibold leading-tight"><%= title %></h1>

  <% if local_assigns[:aside].present? %>
    <span class="ml-auto hidden text-base text-mute sm:block"><%= aside %></span>
  <% end %>

  <%# Pane-level actions (publish, preview) live in the header rather than at
      the bottom of a long form, so they stay reachable while you scroll. %>
  <% if local_assigns[:actions].present? %>
    <div class="ml-auto flex shrink-0 items-center gap-2"><%= actions %></div>
  <% end %>
</div>
