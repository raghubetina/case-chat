<%# Persistent live regions: they exist on every page load, and flash content is
    injected INTO them - a region inserted at announce time is not reliably
    announced by screen readers. Polite for notices, assertive for alerts.

    Styled from the app's own tokens rather than daisyUI's alert palette, which
    paints an info notice bright blue. No theme here is blue.

    Bottom-right, not top-centre. Top-centre lands on the heading and the pane's
    content, which is the placement the guidance warns against; the composer owns
    the bottom centre, so the corner is what is left that covers nothing.

    Notices clear themselves after four seconds. Alerts do not: an error someone
    has to read before they can act cannot leave on a timer. %>
<div id="flash_notices" role="status" class="toast toast-bottom toast-end z-50 empty:hidden">
  <% flash.each do |type, message| %>
    <% next if type.to_s == "alert" || message.blank? %>
    <div class="flash-item flex max-w-md items-center gap-3 rounded-lg border border-line border-l-2 border-l-accent bg-surface px-4 py-3 text-sm text-ink shadow-lg"
         data-controller="dismissable" data-dismissable-after-value="4000"
         data-action="mouseenter->dismissable#hold mouseleave->dismissable#arm focusin->dismissable#hold">
      <span><%= message %></span>
      <button type="button" class="ml-auto shrink-0 rounded-md px-1 text-mute hover:text-ink"
              data-action="dismissable#dismiss" aria-label="<%= t("flash.dismiss") %>">✕</button>
    </div>
  <% end %>
</div>
<div id="flash_alerts" role="alert" class="toast toast-bottom toast-end z-50 empty:hidden">
  <% if flash[:alert].present? %>
    <div class="flash-item flex max-w-md items-center gap-3 rounded-lg border border-line border-l-2 border-l-error bg-surface px-4 py-3 text-sm text-ink shadow-lg"
         data-controller="dismissable">
      <span><%= flash[:alert] %></span>
      <button type="button" class="ml-auto shrink-0 rounded-md px-1 text-mute hover:text-ink"
              data-action="dismissable#dismiss" aria-label="<%= t("flash.dismiss") %>">✕</button>
    </div>
  <% end %>
</div>
