<% content_for :title, t("foundation_domain.entities.enrollments.index.title") %>

<section class="py-10 sm:py-14">
  <header class="mb-8 flex items-end justify-between gap-4">
    <div>
      <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
      <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= t("foundation_domain.entities.enrollments.index.heading") %></h1>
      <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.entities.enrollments.index.lede") %></p>
    </div>
    <%= link_to t("foundation_domain.entities.enrollments.new.action"), new_enrollment_path(return_to: "foundation:mutation-record:show"),
      class: "btn btn-primary" %>
  </header>

  <% if @enrollments.load.any? %>
    <div class="overflow-x-auto rounded-box border border-base-300 bg-base-100">
      <table class="table">
        <caption class="sr-only"><%= t("foundation_domain.entities.enrollments.index.caption") %></caption>
        <thead>
          <tr>
            <th scope="col"><%= t("foundation_domain.entities.enrollments.index.descriptor_label") %></th>
            <th scope="col"><%= t("foundation_domain.entities.enrollments.index.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @enrollments.each do |enrollment| %>
            <tr>
              <td>
                <%= link_to enrollment_path(enrollment), class: "link link-hover font-medium" do %>
                  <%= enrollment.created_at.presence || t("foundation_domain.entities.enrollments.show.unnamed", id: enrollment.id) %>
                <% end %>
              </td>
          <td class="text-right">
            <%= link_to t("foundation_domain.entities.enrollments.edit.action"), edit_enrollment_path(enrollment, return_to: enrollment_path(enrollment)),
              class: "btn btn-ghost btn-sm" %>
          </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <%= render "shared/foundation_pagination", pagy: @pagy %>
  <% elsif @pagy.count.positive? %>
    <section class="rounded-box border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center">
      <h2 class="text-lg font-semibold"><%= t("foundation_domain.pagination.empty.heading") %></h2>
      <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.pagination.empty.body") %></p>
      <%= link_to t("foundation_domain.pagination.empty.action"), enrollments_path,
        class: "btn btn-primary mt-5" %>
    </section>
    <%= render "shared/foundation_pagination", pagy: @pagy %>
  <% else %>
    <section class="rounded-box border border-dashed border-base-300 bg-base-100 px-6 py-12 text-center">
      <h2 class="text-lg font-semibold"><%= t("foundation_domain.entities.enrollments.empty.heading") %></h2>
      <p class="mt-2 text-sm/6 text-base-content/70"><%= t("foundation_domain.entities.enrollments.empty.body") %></p>
    </section>
  <% end %>
</section>
