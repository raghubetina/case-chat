<% descriptor = @user.full_name.presence || t("foundation_domain.entities.users.show.unnamed", id: @user.id) %>
<% content_for :title, t("foundation_domain.entities.users.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.users.fields.full_name") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @user.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.users.fields.email") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @user.email %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.users.fields.program") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @user.program %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.users.show.back"), users_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.users.edit.action"), edit_user_path(@user, return_to: user_path(@user)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.users.destroy.action"), user_path(@user),
      method: :delete, params: {return_to: users_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.users.destroy.confirm")}} %>
  </div>
</section>
