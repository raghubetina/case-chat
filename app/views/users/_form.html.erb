<%= form_with model: record,
  scope: :user,
  url: (record.persisted? ? user_path(record) : users_path),
  method: (record.persisted? ? :patch : :post),
  class: "space-y-6" do |form| %>
  <%= hidden_field_tag :return_to, return_to %>

  <% if record.errors.any? %>
    <section class="alert alert-error" role="alert" aria-labelledby="foundation-form-errors">
      <div>
        <h2 id="foundation-form-errors" class="font-semibold"><%= t("foundation_domain.form.errors.heading") %></h2>
        <ul class="mt-2 list-disc pl-5">
          <% record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <% if record.persisted? %>
    <div>
      <%= form.label :full_name, I18n.t("foundation_domain.entities.users.fields.full_name"), class: "label font-medium" %>
      <%= form.text_field :full_name, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:full_name).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :email, I18n.t("foundation_domain.entities.users.fields.email"), class: "label font-medium" %>
      <%= form.text_field :email, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:email).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :program, I18n.t("foundation_domain.entities.users.fields.program"), class: "label font-medium" %>
      <%= form.text_field :program, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:program).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
  <% else %>
    <div>
      <%= form.label :full_name, I18n.t("foundation_domain.entities.users.fields.full_name"), class: "label font-medium" %>
      <%= form.text_field :full_name, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:full_name).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :email, I18n.t("foundation_domain.entities.users.fields.email"), class: "label font-medium" %>
      <%= form.text_field :email, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:email).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :program, I18n.t("foundation_domain.entities.users.fields.program"), class: "label font-medium" %>
      <%= form.text_field :program, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:program).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("foundation_domain.form.cancel"), cancel_to, class: "btn btn-ghost" %>
  </div>
<% end %>
