<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; background: #f5f5f5; color: #171717; font-family: ui-sans-serif, system-ui, sans-serif; }
      .email-shell { width: 100%; padding: 32px 16px; }
      .email-card { max-width: 560px; margin: 0 auto; padding: 32px; background: #ffffff; border: 1px solid #e5e5e5; border-radius: 16px; }
      .email-brand { margin: 0 0 24px; color: #525252; font-size: 14px; font-weight: 700; }
      h1 { margin: 0 0 16px; font-size: 24px; line-height: 1.25; }
      p { margin: 0 0 16px; line-height: 1.6; }
      .email-button { display: inline-block; margin: 8px 0 24px; padding: 12px 16px; border-radius: 8px; background: #4f46e5; color: #ffffff !important; font-weight: 700; text-decoration: none; }
      .email-muted { color: #737373; font-size: 14px; }
      .email-url { overflow-wrap: anywhere; }
    </style>
  </head>

  <body>
    <div class="email-shell">
      <div class="email-card">
        <p class="email-brand"><%= t("app_name") %></p>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
