<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-turbo-not-loaded="true">
  <head>
    <title><%= full_page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= t("app_name") %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Stamp the persisted theme before first paint (no flash of the wrong theme).
        No stored value (or a stale one) = follow the OS via dusk's `prefersdark`.
        nonce: true keeps this inside the enforced CSP. %>
    <script nonce="<%= content_security_policy_nonce %>">
      const theme = localStorage.getItem("theme");
      if (["ledger", "bureau", "dusk", "chicago"].includes(theme)) document.documentElement.setAttribute("data-theme", theme);
    </script>

    <%# Link only the compiled Tailwind bundle, not its @import-bearing source file. %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <%# Workspace screens are a fixed-height shell that owns the whole viewport:
      it supplies its own rail and its own <main>, and nothing outside it
      scrolls. Every other screen is an ordinary scrolling page under the rail
      header below. %>
  <body class="<%= content_for?(:shell) ? "h-dvh overflow-hidden" : "min-h-screen" %> bg-base-100" data-hotwire-native-app="<%= hotwire_native_app? %>">
    <%= link_to t("nav.skip_to_content"), "#main-content", class: "sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-base-100 focus:p-3" %>

    <% if content_for?(:shell) %>
      <%= render "shared/flash" %>
      <%= yield %>
    <% else %>

    <%# The Design's rail: a dark bar carrying pill navigation, not a light
        daisyUI navbar. Colours come from the theme's --color-rail family, so it
        restyles with the rest of the app rather than being hard-coded dark. %>
    <%# The scroll lives on the pills, not on the header. An overflow ancestor
        clips absolutely positioned descendants, and on the header it truncated
        the theme menu to a five-pixel sliver at the header's own bottom edge. %>
    <%# min-h matches the workspace rail, whose height is set by the account
        menu's avatar rather than by anything here. Without it the chrome
        changed height as you moved between a case and a page outside one. %>
    <header id="app-header" class="app-header sticky top-0 z-20 flex min-h-14 items-center gap-4 border-b border-railline bg-rail px-4 py-2">
      <div class="app-header-start flex min-w-0 shrink items-center gap-1 overflow-x-auto hotwire-native-hidden">
        <%# A short wordmark in the chrome; the full name still titles the page. %>
        <%= link_to t("nav.wordmark"), root_path,
              class: "kick whitespace-nowrap rounded-md px-2 py-1 text-xs text-railink" %>
        <%# The rule separates the wordmark from the pills, so it goes when they do. %>
        <% if current_user %>
          <span class="mx-1 h-4 w-px shrink-0 bg-railline"></span>
        <% end %>
        <%= render "shared/main_navigation" %>
      </div>

      <div class="app-header-end ml-auto flex shrink-0 items-center gap-2 hotwire-native-toolbar">
        <% if current_user %>
          <%= button_to t("nav.sign_out"), rodauth.logout_path, method: :post,
                class: "kick whitespace-nowrap rounded-md px-2 py-1 text-xs pill-off",
                form: {data: {turbo: false}} %>
        <% elsif !current_page?(rodauth.login_path) %>
          <%# Not on the sign-in page itself, where it would point at itself. %>
          <%= link_to t("nav.sign_in"), rodauth.login_path,
                class: "kick whitespace-nowrap rounded-md px-2 py-1 text-xs pill-off" %>
        <% end %>

        <%# The single sanctioned theme knob: pick one of the four Design themes,
            or "auto" to follow the OS preference (chicago by day, dusk by night). %>
        <div class="dropdown dropdown-end" data-controller="theme">
          <button type="button" class="kick rounded-md px-2 py-1 text-xs pill-off" aria-haspopup="menu" aria-label="<%= t("nav.theme.label") %>">
            <%= t("nav.theme.short") %>
          </button>
          <%# Same panel as the account menu's theme section, deliberately. It
              carried daisyUI's `menu` with bare buttons rather than list items,
              so none of that class's styling applied and the options came out
              unpadded and oversized -- a different menu on the same knob. `menu`
              also sets display:flex, which the account menu documents as the way
              to wedge this panel permanently open. %>
          <div aria-label="<%= t("nav.theme.label") %>" class="dropdown-content z-50 mt-1 w-[240px] rounded-lg border border-line bg-surface py-1 shadow">
            <span class="kick block px-3 py-1 text-xs text-mute"><%= t("nav.theme.label") %></span>
            <% %w[ledger bureau dusk chicago auto].each do |name| %>
              <button type="button" aria-pressed="false"
                class="block w-full px-3 py-2 text-left text-sm hover:bg-wash"
                data-theme-target="option" data-action="theme#set" data-theme-name-param="<%= name %>">
                <%= t("nav.theme.#{name}") %>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    </header>

    <%= render "shared/flash" %>

    <%# Most pages are a centred column. The thread is not: it is a full-height
        two-pane workspace, and the container's max-width and padding squeeze it
        into a narrow off-centre strip. A view opts out with content_for. %>
    <main id="main-content" class="<%= content_for?(:full_bleed) ? "" : "container mx-auto px-4" %>" tabindex="-1">
      <%= yield %>
    </main>
    <% end %>
  </body>
</html>
