<%= form_with model: record,
  scope: :contact,
  url: (record.persisted? ? contact_path(record) : contacts_path),
  method: (record.persisted? ? :patch : :post),
  class: "space-y-6" do |form| %>
  <%= hidden_field_tag :return_to, return_to %>

  <% if record.errors.any? %>
    <section class="alert alert-error" role="alert" aria-labelledby="foundation-form-errors">
      <div>
        <h2 id="foundation-form-errors" class="font-semibold"><%= t("foundation_domain.form.errors.heading") %></h2>
        <ul class="mt-2 list-disc pl-5">
          <% record.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    </section>
  <% end %>

  <% if record.persisted? %>
    <div>
      <%= form.label :full_name, I18n.t("foundation_domain.entities.contacts.fields.full_name"), class: "label font-medium" %>
      <%= form.text_field :full_name, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:full_name).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :role_title, I18n.t("foundation_domain.entities.contacts.fields.role_title"), class: "label font-medium" %>
      <%= form.text_field :role_title, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:role_title).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :case_study_id, I18n.t("foundation_domain.entities.contacts.fields.case_study_id"), class: "label font-medium" %>
      <%= form.select :case_study_id, @case_study_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
      <% record.errors.full_messages_for(:case_study).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
  <% else %>
    <div>
      <%= form.label :full_name, I18n.t("foundation_domain.entities.contacts.fields.full_name"), class: "label font-medium" %>
      <%= form.text_field :full_name, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:full_name).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :role_title, I18n.t("foundation_domain.entities.contacts.fields.role_title"), class: "label font-medium" %>
      <%= form.text_field :role_title, required: true, class: "input input-bordered w-full" %>
      <% record.errors.full_messages_for(:role_title).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
    <div>
      <%= form.label :case_study_id, I18n.t("foundation_domain.entities.contacts.fields.case_study_id"), class: "label font-medium" %>
      <%= form.select :case_study_id, @case_study_id_options, {include_blank: true}, {class: "select select-bordered w-full", required: true} %>
      <% record.errors.full_messages_for(:case_study).each do |message| %>
        <p class="mt-1 text-sm text-error"><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <div class="flex items-center gap-3">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to t("foundation_domain.form.cancel"), cancel_to, class: "btn btn-ghost" %>
  </div>
<% end %>
