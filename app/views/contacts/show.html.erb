<% descriptor = @contact.full_name.presence || t("foundation_domain.entities.contacts.show.unnamed", id: @contact.id) %>
<% content_for :title, t("foundation_domain.entities.contacts.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.contacts.fields.full_name") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @contact.full_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.contacts.fields.role_title") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @contact.role_title %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.contacts.fields.description") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @contact.description %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.contacts.fields.system_prompt") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @contact.system_prompt %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.contacts.fields.in_starting_directory") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @contact.in_starting_directory %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.contacts.show.back"), contacts_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.contacts.edit.action"), edit_contact_path(@contact, return_to: contact_path(@contact)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.contacts.destroy.action"), contact_path(@contact),
      method: :delete, params: {return_to: contacts_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.contacts.destroy.confirm")}} %>
  </div>
</section>
