<% descriptor = @case_study.title.presence || t("foundation_domain.entities.case_studies.show.unnamed", id: @case_study.id) %>
<% content_for :title, t("foundation_domain.entities.case_studies.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.title") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.title %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.course") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.course %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.background") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.background %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.assignment") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.assignment %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.join_code") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.join_code %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.due_at") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.due_at %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.case_studies.fields.published") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @case_study.published %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.case_studies.show.back"), case_studies_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.case_studies.edit.action"), edit_case_study_path(@case_study, return_to: case_study_path(@case_study)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.case_studies.destroy.action"), case_study_path(@case_study),
      method: :delete, params: {return_to: case_studies_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.case_studies.destroy.confirm")}} %>
  </div>
</section>
