<% descriptor = @document.file_name.presence || t("foundation_domain.entities.documents.show.unnamed", id: @document.id) %>
<% content_for :title, t("foundation_domain.entities.documents.show.title", descriptor: descriptor) %>

<section class="mx-auto max-w-2xl py-10 sm:py-14">
  <header class="mb-8">
    <p class="text-sm font-medium text-primary"><%= t("app_name") %></p>
    <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl"><%= descriptor %></h1>
  </header>

    <dl class="mb-8 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.documents.fields.file_name") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @document.file_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.documents.fields.description") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @document.description %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.documents.fields.given_at_start") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @document.given_at_start %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.documents.fields.file_url") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @document.file_url %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-base-content/70"><%= I18n.t("foundation_domain.entities.documents.fields.byte_size") %></dt>
        <dd class="mt-1 whitespace-pre-wrap break-words"><%= @document.byte_size %></dd>
      </div>
    </dl>

  <div class="flex items-center gap-3">
    <%= link_to t("foundation_domain.entities.documents.show.back"), documents_path, class: "btn btn-ghost" %>
    <%= link_to t("foundation_domain.entities.documents.edit.action"), edit_document_path(@document, return_to: document_path(@document)),
      class: "btn btn-primary" %>
    <%= button_to t("foundation_domain.entities.documents.destroy.action"), document_path(@document),
      method: :delete, params: {return_to: documents_path}, class: "btn btn-error btn-outline",
      form: {data: {turbo_confirm: t("foundation_domain.entities.documents.destroy.confirm")}} %>
  </div>
</section>
